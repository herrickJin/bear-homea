# 访问令牌：小程序 / H5 / MCP 客户端统一用 Bearer Token
BEAR_HOME_TOKEN=change-me-to-a-long-random-string

# 服务端口
PORT=8787

# 数据目录（SQLite 数据库与上传文件都放这里，记得挂载/备份）
DATA_DIR=./data

# 部署域名（Caddy 用；留空则按 localhost 提供自签证书）
# BEAR_HOME_DOMAIN=bear.example.com

# 允许跨域的前端来源，逗号分隔（开发期默认含 vite 5173；生产同域部署可留空）
# CORS_ORIGINS=http://localhost:5173

# AI 助手（/api/chat）：OpenAI 兼容端点。不配则聊天接口返回 503，其余功能不受影响。
# 默认智谱（服务器可达，~100ms），Key 在智谱控制台创建；模型默认 glm-4-flash（免费档，支持工具调用）
# AI_API_KEY=
# AI_API_BASE=https://open.bigmodel.cn/api/paas/v4
# AI_CHAT_MODEL=glm-4-flash
