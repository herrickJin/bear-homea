{
  "name": "bear-home",
  "private": true,
  "version": "0.3.0",
  "scripts": {
    "dev": "npm run dev:h5",
    "dev:h5": "taro build --type h5 --watch",
    "dev:weapp": "taro build --type weapp --watch",
    "build": "npm run typecheck && npm run build:h5 && npm run build:weapp",
    "build:h5": "taro build --type h5",
    "build:weapp": "taro build --type weapp",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/generate-icons.cjs"
  },
  "dependencies": {
    "@tarojs/components": "4.3.0",
    "@tarojs/helper": "4.3.0",
    "@tarojs/react": "^4.3.0",
    "@tarojs/runtime": "4.3.0",
    "@tarojs/shared": "4.3.0",
    "@tarojs/taro": "4.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-react": "^7.29.7",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.17",
    "@tarojs/cli": "4.3.0",
    "@tarojs/plugin-framework-react": "4.3.0",
    "@tarojs/plugin-platform-h5": "4.3.0",
    "@tarojs/plugin-platform-weapp": "4.3.0",
    "@tarojs/webpack5-runner": "4.3.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "babel-preset-taro": "4.3.0",
    "lucide-react": "^0.468.0",
    "prettier": "^3.9.9",
    "react-refresh": "^0.14.2",
    "sharp": "^0.33.5",
    "typescript": "~5.7.2",
    "webpack": "5.91.0"
  }
}
